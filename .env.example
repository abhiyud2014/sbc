# ---------------------------------------------------------------------------
# Zoom Server-to-Server OAuth app credentials
# Marketplace -> "Developed Apps" -> your app -> "Server-to-Server OAuth"
# Copy this file to `.env` and fill in the real values. NEVER commit .env.
# ---------------------------------------------------------------------------

ZOOM_ACCOUNT_ID=your_account_id
ZOOM_CLIENT_ID=your_client_id
ZOOM_CLIENT_SECRET=your_client_secret

# Optional: the "Secret Token" from the app page is only needed if you enable
# Zoom webhooks later. Not used by the REST proxy.
ZOOM_WEBHOOK_SECRET_TOKEN=

# Dashboard sign-in. ADMIN_PIN is required before the admin can sign in.
# STUDENT_PASSCODE is the initial shared class password; the admin can rotate it
# in the UI, and individual students can set their own password.
ADMIN_PIN=
STUDENT_PASSCODE=

# Optional: roster cache TTL in milliseconds (default 300000 = 5 minutes).
ROSTER_CACHE_MS=300000

# Ports (local Node API only; Cloudflare uses the Worker URL)
PORT=8787

# Cloudflare: do NOT copy this file to .dev.vars with real values committed.
# .dev.vars is git-ignored. Production values go in `wrangler secret put ...`.
